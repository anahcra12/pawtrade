<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>About Us | PawTrade</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@700&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-[#DAD7CD] font-[Inter] text-[#344E41]">

    <%- include('partials/header',{page:'about'}) %>

    <!-- Hero -->
    <section class="pt-40 pb-24 bg-gradient-to-b from-[#E8EEDC] to-[#DAD7CD]">

        <div class="max-w-7xl mx-auto px-6">

            <span
                class="inline-block rounded-full bg-[#588157]/10 px-5 py-2 text-sm font-semibold tracking-[0.25em] uppercase text-[#588157]">

                About PawTrade

            </span>

            <h1 class="mt-8 font-[Fraunces] text-5xl md:text-7xl font-bold leading-tight">

                Built by Students.

                <br>

                <span class="text-[#588157] italic">

                    Trusted by Students.

                </span>

            </h1>

            <p class="mt-8 max-w-3xl text-xl leading-9 text-[#556861]">

                PawTrade is an exclusive marketplace built for the
                students of IIEST Shibpur.

                Buy, sell and exchange books, cycles, electronics,
                calculators, furniture and much more — safely inside
                your own campus community.

            </p>

        </div>

    </section>

    <!-- Story -->

    <section class="py-24">

        <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">

            <div>

                <span class="uppercase tracking-[0.3em] text-[#588157] font-semibold">

                    Our Story

                </span>

                <h2 class="mt-4 font-[Fraunces] text-5xl">

                    Why PawTrade?

                </h2>

                <p class="mt-8 text-lg leading-9 text-[#556861]">

                    Every semester, seniors leave behind valuable
                    books, electronics, cycles, calculators and
                    hostel essentials.

                    Juniors often buy the same things again because
                    there is no trusted place to connect.

                    PawTrade solves this problem by creating one
                    verified marketplace exclusively for IIEEST
                    Shibpur students.

                </p>

            </div>

            <div>

                <img
                    src="/photos/iiest-campus.jpg"
                    class="rounded-3xl shadow-2xl object-cover w-full h-[450px]"
                    alt="IIEST Campus">

            </div>

        </div>

    </section>

    <!-- Stats -->

    <section class="bg-[#344E41] py-20 text-white">

        <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-4 gap-10 text-center">

            <div>

                <h2 class="text-5xl font-bold">

                    100%

                </h2>

                <p class="mt-3 text-gray-300">

                    Verified Students

                </p>

            </div>

            <div>

                <h2 class="text-5xl font-bold">

                    0%

                </h2>

                <p class="mt-3 text-gray-300">

                    Platform Commission

                </p>

            </div>

            <div>

                <h2 class="text-5xl font-bold">

                    24×7

                </h2>

                <p class="mt-3 text-gray-300">

                    Marketplace Access

                </p>

            </div>

            <div>

                <h2 class="text-5xl font-bold">

                    1

                </h2>

                <p class="mt-3 text-gray-300">

                    Trusted Campus

                </p>

            </div>

        </div>

    </section>

    <!-- Values -->

    <section class="py-24">

        <div class="max-w-7xl mx-auto px-6">

            <h2 class="font-[Fraunces] text-5xl text-center">

                Our Values

            </h2>

            <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-8 mt-16">

                <div class="rounded-3xl bg-white p-8 shadow-lg hover:-translate-y-2 transition">

                    <div class="text-5xl">🎓</div>

                    <h3 class="mt-6 text-2xl font-semibold">

                        Verified Students

                    </h3>

                    <p class="mt-4 text-[#556861] leading-8">

                        Every account is linked with an official
                        college email and student identity.

                    </p>

                </div>

                <div class="rounded-3xl bg-white p-8 shadow-lg hover:-translate-y-2 transition">

                    <div class="text-5xl">🤝</div>

                    <h3 class="mt-6 text-2xl font-semibold">

                        Safe Deals

                    </h3>

                    <p class="mt-4 text-[#556861] leading-8">

                        Meet on campus, inspect the item and pay
                        only when you're satisfied.

                    </p>

                </div>

                <div class="rounded-3xl bg-white p-8 shadow-lg hover:-translate-y-2 transition">

                    <div class="text-5xl">📍</div>

                    <h3 class="mt-6 text-2xl font-semibold">

                        Nearby Pickup

                    </h3>

                    <p class="mt-4 text-[#556861] leading-8">

                        Find products around hostels and halls for
                        quick and convenient exchanges.

                    </p>

                </div>

                <div class="rounded-3xl bg-white p-8 shadow-lg hover:-translate-y-2 transition">

                    <div class="text-5xl">♻️</div>

                    <h3 class="mt-6 text-2xl font-semibold">

                        Sustainable Campus

                    </h3>

                    <p class="mt-4 text-[#556861] leading-8">

                        Reduce waste by giving useful products a
                        second life within the campus community.

                    </p>

                </div>

            </div>

        </div>

    </section>

    <!-- CTA -->

    <section class="py-24 bg-[#E8EEDC]">

        <div class="max-w-4xl mx-auto text-center px-6">

            <h2 class="font-[Fraunces] text-5xl">

                Ready to Join PawTrade?

            </h2>

            <p class="mt-6 text-lg text-[#556861]">

                Discover affordable products, help fellow students,
                and make campus life easier.

            </p>

            <div class="mt-12 flex justify-center gap-6 flex-wrap">

                <a href="/explore"
                    class="rounded-full bg-[#588157] px-8 py-4 text-white font-semibold hover:bg-[#3A5A40] transition">

                    Explore Campus

                </a>

                <a href="/marketplace"
                    class="rounded-full border-2 border-[#588157] px-8 py-4 font-semibold hover:bg-[#588157] hover:text-white transition">

                    Browse Marketplace

                </a>

            </div>

        </div>

    </section>

    <%- include('partials/footer') %>

</body>

</html>
